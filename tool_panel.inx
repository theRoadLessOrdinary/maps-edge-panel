<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Tool Panel</name>
	<id>maps_edge.tool_panel</id>

	<effect needs-live-preview="false">
		<object-type>all</object-type>
		<effects-menu>
			<submenu name="Map's Edge Tools" translatable="no" />
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">tool_panel.py</command>
	</script>

</inkscape-extension>
